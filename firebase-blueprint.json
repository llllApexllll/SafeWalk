{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with personal and emergency medical information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "bloodType": { "type": "string" },
        "physicalCapacity": { "type": "string", "description": "Mobility or physical capacity status (Phcap)" },
        "chronicIllnesses": { "type": "string", "description": "Medical illnesses or conditions" },
        "medications": { "type": "string", "description": "Current active medications" },
        "allergies": { "type": "string", "description": "Known allergies" },
        "emergencyNotes": { "type": "string" },
        "themePreference": {
          "type": "string",
          "enum": ["DARK", "LIGHT", "SYSTEM", "AUTO"]
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "themePreference", "updatedAt"]
    },
    "FavoriteRoute": {
      "title": "FavoriteRoute",
      "description": "User saved favorite safe walking routes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startAddress": { "type": "string" },
        "destinationName": { "type": "string" },
        "routeType": { "type": "string" },
        "safetyScore": { "type": "number" },
        "lightingPercentage": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "destinationName", "routeType", "safetyScore", "createdAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Crowdsourced safety report submitted anonymously or by user, reviewed for accuracy.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "BROKEN_LIGHTING",
            "DARK_ALLEY",
            "SUSPICIOUS_ACTIVITY",
            "HARASSMENT",
            "ACCIDENT",
            "SUDDEN_POLICE_ACTIVITY",
            "ENVIRONMENTAL_HAZARD",
            "SAFE_HAVEN_24_7"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "addressName": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verificationStatus": {
          "type": "string",
          "enum": ["PENDING_REVIEW", "VERIFIED", "COMMUNITY_CONFIRMED"]
        },
        "upvotes": { "type": "number" },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "title",
        "category",
        "severity",
        "latitude",
        "longitude",
        "addressName",
        "isVerified",
        "verificationStatus",
        "upvotes",
        "isAnonymous",
        "createdAt",
        "updatedAt"
      ]
    },
    "RealtimeAlert": {
      "title": "RealtimeAlert",
      "description": "Immediate safety alert prioritized by severity and proximity along pre-defined route.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "SUDDEN_POLICE_ACTIVITY",
            "ACCIDENT",
            "CRIME_SURGE",
            "STREET_BLACKOUT",
            "ACTIVE_HAZARD"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM"]
        },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusMeters": { "type": "number" },
        "affectedStreet": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "message",
        "type",
        "severity",
        "latitude",
        "longitude",
        "radiusMeters",
        "affectedStreet",
        "createdAt"
      ]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "Trusted emergency contact stored securely in user profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "relationship": { "type": "string" },
        "isPrimary": { "type": "boolean" },
        "notifyOnSos": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "phoneNumber",
        "relationship",
        "isPrimary",
        "notifyOnSos",
        "createdAt",
        "updatedAt"
      ]
    },
    "SosLog": {
      "title": "SosLog",
      "description": "Audit record of SOS activation with location and distress message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "address": { "type": "string" },
        "distressMessage": { "type": "string" },
        "contactsNotified": { "type": "string" },
        "emergencyDialed": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "latitude",
        "longitude",
        "address",
        "distressMessage",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile_data/{profileId}": {
      "schema": "UserProfile",
      "description": "User profile with medical info and theme preference."
    },
    "/users/{userId}/favorite_routes/{routeId}": {
      "schema": "FavoriteRoute",
      "description": "User saved favorite walking routes."
    },
    "/users/{userId}/emergency_contacts/{contactId}": {
      "schema": "EmergencyContact",
      "description": "User trusted emergency contacts."
    },
    "/users/{userId}/sos_history/{sosId}": {
      "schema": "SosLog",
      "description": "Historical SOS trigger log."
    },
    "/community_reports/{reportId}": {
      "schema": "CommunityReport",
      "description": "Crowdsourced safety reports reviewed and incorporated into safe routes."
    },
    "/realtime_alerts/{alertId}": {
      "schema": "RealtimeAlert",
      "description": "Active real-time safety alerts monitoring user location and active route."
    }
  }
}
